{
  "name": "ha-nhi-fashion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "NEXT_DIST_DIR=.next-production next build",
    "start": "NEXT_DIST_DIR=.next-production next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "tsx scripts/prepare-tests.ts && playwright test",
    "admin:create": "tsx scripts/create-admin.ts",
    "format": "prettier --write src prisma/seed.ts scripts tests *.ts *.json *.mjs",
    "catalog:audit": "tsx scripts/audit-catalog.ts",
    "catalog:upgrade": "tsx scripts/upgrade-catalog.ts",
    "lint": "eslint src scripts tests --max-warnings 0",
    "test:orders": "tsx scripts/run-order-phase1.ts",
    "test:shipping": "tsx scripts/run-order-phase1.ts --shipping",
    "test:returns": "tsx scripts/run-order-phase1.ts --returns --stable",
    "test:rbac": "tsx scripts/run-order-phase1.ts --rbac --stable",
    "test:phase5": "tsx scripts/run-order-phase1.ts --phase5 --stable",
    "data:quality": "tsx scripts/audit-phase5.ts",
    "db:backup": "python3 scripts/local-backup.py",
    "test:phase6": "tsx scripts/run-order-phase1.ts --phase6 --stable",
    "analytics:backfill": "tsx scripts/analytics-maintenance.ts --backfill",
    "analytics:retention": "tsx scripts/analytics-maintenance.ts --retention",
    "test:business": "tsx scripts/run-order-phase1.ts --phase6 --stable --acceptance"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "type": "module"
}

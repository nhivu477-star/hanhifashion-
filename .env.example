# Existing local databases are private. This file never supplies account passwords.
# Prefer `npm run demo:setup` then `npm run demo:dev`: both use a NEW isolated
# .local-demo/portfolio/demo.db without reading or overwriting this DATABASE_URL.
# Use this only for an intentionally configured non-demo local database.
DATABASE_URL="file:./dev.db"

# Preview allows explicitly unverified SAMPLE catalog data and simulated payments.
# It is not a production setting or an external shipping/payment integration.
# Commercial publication additionally requires verified merchandise/media/stock.
STORE_MODE="preview"

# Local demo reset mail is written privately to ignored .local-mail/.
# Never expose the loopback demo server, copy generated credentials into Git,
# or set real carrier/payment secrets for this local-only workflow.

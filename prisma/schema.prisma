generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  reviews ProductReview[]
  reviewReplies ReviewReply[]
  inquiryReplies InquiryReply[]
  stocktakes Stocktake[]
  inquiries Inquiry[]
  preference ShopperPreference?
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String
  passwordHash      String
  role              String          @default("CUSTOMER")
  permissionVersion Int             @default(0)
  lastLoginAt       DateTime?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          Session[]
  accounts          Account[]
  addresses         Address[]
  returns           ReturnRequest[]
  orders            Order[]
  wishlist          Wishlist?
  cart              Cart?
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                String   @id @default(cuid())
  permissionVersion Int      @default(0)
  tokenHash         String   @unique
  userId            String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Address {
  isDefault Boolean @default(false)
  countryCode String @default("VN")
  postalCode String @default("")
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  province  String
  ward      String
  street    String
  details   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id                  String     @id @default(cuid())
  name                String
  slug                String     @unique
  description         String
  image               String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  parentId            String?
  parent              Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[] @relation("CategoryTree")
  active              Boolean    @default(true)
  sortOrder           Int        @default(0)
  sizeChart           SizeChart?
  products            Product[]  @relation("PrimaryCategory")
  subcategoryProducts Product[]  @relation("Subcategory")

  @@index([parentId, sortOrder])
}

model Product {
  reviews ProductReview[]
  costHistory         ProductCostHistory[]
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  sku                 String               @unique
  description         String
  material            String
  style               String
  fit                 String
  occasion            String
  price               Int
  salePrice           Int?
  active              Boolean              @default(true)
  featured            Boolean              @default(false)
  isNew               Boolean              @default(false)
  searchText          String
  categoryId          String
  subcategoryId       String?
  sleeveType          String               @default("")
  length              String               @default("")
  styleTags           String               @default("")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  category            Category             @relation("PrimaryCategory", fields: [categoryId], references: [id])
  subcategory         Category?            @relation("Subcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  images              ProductImage[]
  variants            ProductVariant[]
  collections         CollectionProduct[]
  details             String               @default("")
  care                String               @default("")
  styling             String               @default("")
  fitClass            String               @default("regular")
  stretchVerified     Boolean              @default(false)
  stretchAllowance    Float                @default(0)
  enrichmentVersion   Int                  @default(0)
  publicationStatus   String               @default("PENDING_ASSETS")
  merchandiseVerified Boolean              @default(false)
  mediaAssets         MediaAsset[]
  colors              ProductColor[]
  sizeChart           SizeChart?
  outfitItems         OutfitItem[]
  wishlistItems       WishlistItem[]
  orderItems          OrderItem[]

  @@index([categoryId, active, createdAt])
  @@index([featured, isNew])
}

model ProductImage {
  id           String      @id @default(cuid())
  productId    String
  url          String
  alt          String
  position     Int         @default(0)
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  stocktakeLines StocktakeLine[]
  costHistory   ProductCostHistory[]
  id            String               @id @default(cuid())
  productId     String
  sku           String               @unique
  size          String
  color         String
  colorHex      String
  colorId       String?
  colorRecord   ProductColor?        @relation(fields: [colorId], references: [id], onDelete: Restrict)
  stock         Int                  @default(0)
  stockOrigin   String               @default("UNVERIFIED")
  priceOverride Int?
  updatedAt     DateTime             @updatedAt
  product       Product              @relation(fields: [productId], references: [id])
  cartItems     CartItem[]
  orderItems    OrderItem[]
  exchanges     ExchangeItem[]
  movements     InventoryMovement[]

  @@unique([productId, size, color])
  @@index([stock])
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String
  image       String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Cart {
  analyticsCycles CartAnalyticsCycle[]
  id              String               @id @default(cuid())
  userId          String?              @unique
  guestToken      String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  packingHoldReason String?
  assignedTo String?
  priority String @default("NORMAL")
  reviews ProductReview[]
  packingRequired Boolean @default(false)
  packedAt DateTime?
  packedBy String?
  countryCode String @default("VN")
  postalCode String @default("")
  attribution       OrderAttribution?
  analyticsCycles   CartAnalyticsCycle[]
  id                String               @id @default(cuid())
  code              String               @unique
  accessToken       String               @unique
  idempotencyKey    String               @unique
  userId            String?
  name              String
  phone             String
  email             String
  province          String
  ward              String
  street            String
  details           String
  notes             String
  status            String               @default("PENDING")
  paymentStatus     String               @default("UNPAID")
  shippingStatus    String               @default("NOT_DISPATCHED")
  shippingReference String?
  subtotal          Int
  discount          Int
  shipping          Int
  total             Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User?                @relation(fields: [userId], references: [id])
  items             OrderItem[]
  history           OrderStatusHistory[]
  payments          Payment[]
  redemption        CouponRedemption?
  returns           ReturnRequest[]
  refunds           MockRefund[]
  shipment          Shipment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  originalQuantity Int?
  analytics   OrderLineAnalytics?
  id          String              @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  name        String
  sku         String
  size        String
  color       String
  image       String
  quantity    Int
  unitPrice   Int
  order       Order               @relation(fields: [orderId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])
  variant     ProductVariant      @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]
}

model OrderStatusHistory {
  previousStatus String?
  actorId        String?
  actorLabel     String?
  event          String   @default("STATUS_CHANGE")
  id             String   @id @default(cuid())
  orderId        String
  status         String
  note           String
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  collectedAt         DateTime?
  collectedBy         String?
  collectionReference String?
  id                  String       @id @default(cuid())
  orderId             String
  method              String       @default("COD")
  amount              Int
  status              String       @default("UNPAID")
  createdAt           DateTime     @default(now())
  order               Order        @relation(fields: [orderId], references: [id])
  refunds             MockRefund[]
  shipment            Shipment?
}

model InventoryMovement {
  kind String @default("ADJUSTMENT")
  occurredAt DateTime?
  supplier String?
  notes String?
  eventKey String? @unique

  orderId   String?
  actorId   String?
  id        String         @id @default(cuid())
  variantId String
  delta     Int
  reason    String
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model Coupon {
  startsAt DateTime?
  id          String             @id @default(cuid())
  code        String             @unique
  type        String
  value       Int
  minimum     Int                @default(0)
  maximum     Int?
  expiresAt   DateTime
  usageLimit  Int
  used        Int                @default(0)
  active      Boolean            @default(true)
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  orderId  String @unique
  coupon   Coupon @relation(fields: [couponId], references: [id])
  order    Order  @relation(fields: [orderId], references: [id])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  image     String
  href      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  resourceType String   @default("LEGACY")
  result       String   @default("SUCCESS")
  beforeJson   String?
  afterJson    String?
  reason       String?
  id           String   @id @default(cuid())
  actorId      String
  action       String
  targetId     String
  detail       String
  createdAt    DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Inquiry {
  replies InquiryReply[]
  @@index([userId, createdAt])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model ProductColor {
  active      Boolean             @default(true)
  id          String              @id @default(cuid())
  productId   String
  name        String
  hex         String
  position    Int                 @default(0)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images      ColorImage[]
  mediaAssets MediaAsset[]
  variants    ProductVariant[]
  outfits     OutfitCombination[]
  styledItems OutfitItem[]

  @@unique([productId, name])
}

model ColorImage {
  id           String       @id @default(cuid())
  colorId      String
  url          String
  alt          String
  position     Int          @default(0)
  color        ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  mediaAssetId String?

  @@index([colorId, position])
}

model OutfitCombination {
  id       String       @id @default(cuid())
  colorId  String
  title    String
  position Int          @default(0)
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  items    OutfitItem[]

  @@index([colorId, position])
}

model OutfitItem {
  id        String            @id @default(cuid())
  outfitId  String
  productId String
  colorId   String
  outfit    OutfitCombination @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  color     ProductColor      @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([outfitId, productId])
}

model SizeChart {
  id         String    @id @default(cuid())
  categoryId String?   @unique
  productId  String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       String
  notes      String
  rowsJson   String
  matrixJson String
  updatedAt  DateTime  @updatedAt
}

model MediaAsset {
  id                String         @id @default(cuid())
  localPath         String         @unique
  originalSourceUrl String
  creator           String         @default("")
  licenseType       String
  licenseReference  String
  retrievedAt       DateTime       @default(now())
  authorizedUse     String
  role              String         @default("DEVELOPMENT")
  reviewStatus      String         @default("PENDING")
  verificationNotes String         @default("")
  garmentVerified   Boolean        @default(false)
  reviewedAt        DateTime?
  productId         String?
  colorId           String?
  focalX            Float          @default(50)
  focalY            Float          @default(50)
  product           Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  color             ProductColor?  @relation(fields: [colorId], references: [id], onDelete: Restrict)
  productImages     ProductImage[]
  colorImages       ColorImage[]

  @@index([reviewStatus, role])
}

model Shipment {
  lengthCm              Int?
  widthCm               Int?
  heightCm              Int?
  insuredValue          Int       @default(0)
  providerClientRef     String?   @unique
  providerShopId        Int?
  providerCode          String?   @unique
  providerSyncStatus    String    @default("NOT_SUBMITTED")
  providerVerification  String    @default("UNVERIFIED")
  providerSubmittedAt   DateTime?
  providerLastSyncedAt  DateTime?
  providerLastEventAt   DateTime?
  providerCorrelationId String?
  providerRequestDigest String?
  providerErrorCode     String?
  providerErrorAt       DateTime?

  id                   String              @id @default(cuid())
  orderId              String              @unique
  paymentId            String              @unique
  reference            String              @unique
  provider             String              @default("LOCAL_MANUAL")
  carrierReference     String?
  status               String              @default("PENDING")
  shippingFee          Int
  expectedCOD          Int
  collectedCOD         Int                 @default(0)
  remittedCOD          Int                 @default(0)
  outstandingCOD       Int                 @default(0)
  reconciliationStatus String              @default("PENDING")
  reconciledAt         DateTime?
  reconciledBy         String?
  reconciliationNote   String?
  discrepancyNote      String?
  version              Int                 @default(0)
  recipientName        String
  recipientPhone       String
  recipientAddress     String
  parcelDescription    String
  weightGrams          Int
  parcelCount          Int                 @default(1)
  createdBy            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment              Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  events               ShipmentEvent[]
  attempts             DeliveryAttempt[]
  collections          CODCollection[]
  remittances          CODRemittance[]
  reconciliations      CODReconciliation[]

  @@index([status, createdAt])
  @@index([reconciliationStatus, createdAt])
}

model ShipmentEvent {
  providerEventKey  String?   @unique
  providerStatus    String?
  providerEventType String?
  providerTimestamp DateTime?
  providerPayload   String?
  disposition       String?

  id             String   @id @default(cuid())
  shipmentId     String
  previousStatus String?
  status         String
  actorId        String
  source         String   @default("LOCAL_MANUAL")
  reason         String?
  createdAt      DateTime @default(now())
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
}

model DeliveryAttempt {
  id         String   @id @default(cuid())
  shipmentId String
  reasonCode String
  note       String
  actorId    String
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
}

model CODCollection {
  id          String          @id @default(cuid())
  shipmentId  String
  eventKey    String          @unique
  provider    String
  reference   String
  amount      Int
  evidence    String
  occurredAt  DateTime
  actorId     String
  correctsId  String?
  createdAt   DateTime        @default(now())
  shipment    Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  corrects    CODCollection?  @relation("CollectionCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections CODCollection[] @relation("CollectionCorrection")

  @@unique([provider, reference])
  @@index([shipmentId, occurredAt])
}

model CODRemittance {
  id          String          @id @default(cuid())
  shipmentId  String
  eventKey    String          @unique
  provider    String
  reference   String
  amount      Int
  evidence    String
  occurredAt  DateTime
  actorId     String
  correctsId  String?
  createdAt   DateTime        @default(now())
  shipment    Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  corrects    CODRemittance?  @relation("RemittanceCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections CODRemittance[] @relation("RemittanceCorrection")

  @@unique([provider, reference])
  @@index([shipmentId, occurredAt])
}

model CODReconciliation {
  id             String   @id @default(cuid())
  shipmentId     String
  eventKey       String   @unique
  action         String
  previousStatus String
  status         String
  expected       Int
  collected      Int
  remitted       Int
  outstanding    Int
  note           String
  actorId        String
  createdAt      DateTime @default(now())
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
}

model ReturnRequest {
  id            String           @id @default(cuid())
  reference     String           @unique
  eventKey      String           @unique
  payloadHash   String
  orderId       String
  userId        String
  status        String           @default("REQUESTED")
  resolution    String
  reason        String
  policyVersion String
  deliveredAt   DateTime
  deadline      DateTime
  released      Boolean          @default(false)
  version       Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         ReturnItem[]
  history       ReturnHistory[]
  evidence      ReturnEvidence[]
  refund        MockRefund?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model ReturnItem {
  id          String             @id @default(cuid())
  requestId   String
  orderItemId String
  quantity    Int
  amount      Int
  disposition String?
  restocked   Boolean            @default(false)
  request     ReturnRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  orderItem   OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  inspections ReturnInspection[]
  exchange    ExchangeItem?

  @@unique([requestId, orderItemId])
  @@index([orderItemId])
}

model ReturnEvidence {
  id        String        @id @default(cuid())
  requestId String
  mime      String
  data      String
  createdAt DateTime      @default(now())
  request   ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
}

model ReturnInspection {
  id        String     @id @default(cuid())
  itemId    String
  actorId   String
  condition String
  notes     String
  evidence  String
  createdAt DateTime   @default(now())
  item      ReturnItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
}

model ReturnHistory {
  id             String        @id @default(cuid())
  requestId      String
  previousStatus String?
  status         String
  actorId        String
  reason         String
  createdAt      DateTime      @default(now())
  request        ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model ExchangeItem {
  id            String         @id @default(cuid())
  itemId        String         @unique
  variantId     String
  sku           String
  name          String
  size          String
  color         String
  quantity      Int
  unitPrice     Int
  reference     String         @unique
  status        String         @default("PENDING")
  stockRestored Boolean        @default(false)
  createdBy     String
  createdAt     DateTime       @default(now())
  item          ReturnItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model MockRefund {
  id              String        @id @default(cuid())
  reference       String        @unique
  requestId       String        @unique
  orderId         String
  paymentId       String
  amount          Int
  shippingAmount  Int           @default(0)
  reason          String
  status          String        @default("PENDING")
  approvalActor   String?
  completionActor String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  request         ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

// Local first-party analytics only. No auth tokens, IP, user-agent or personal search text.
model VisitorSession {
  id           String             @id @default(cuid())
  keyHash      String             @unique
  startedAt    DateTime           @default(now())
  lastSeenAt   DateTime           @default(now())
  expiresAt    DateTime
  source       String             @default("direct")
  medium       String             @default("")
  campaign     String             @default("")
  content      String             @default("")
  term         String             @default("")
  events       AnalyticsEvent[]
  attributions OrderAttribution[]

  @@index([startedAt])
  @@index([expiresAt])
}

model AnalyticsEvent {
  id            String         @id @default(cuid())
  eventKey      String         @unique
  visitorId     String
  type          String
  productId     String?
  authenticated Boolean        @default(false)
  createdAt     DateTime       @default(now())
  metadataJson  String         @default("{}")
  visitor       VisitorSession @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, type, createdAt])
  @@index([type, createdAt])
  @@index([productId, createdAt])
}

model CartAnalyticsCycle {
  id             String    @id @default(cuid())
  cartId         String
  firstSeenAt    DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  orderId        String?   @unique
  convertedAt    DateTime?
  snapshotJson   String    @default("[]")
  cart           Cart      @relation(fields: [cartId], references: [id], onDelete: Restrict)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([firstSeenAt, lastActivityAt])
  @@index([cartId, orderId])
}

model OrderAttribution {
  orderId    String          @id
  visitorId  String?
  capturedAt DateTime        @default(now())
  source     String
  medium     String
  campaign   String
  content    String
  term       String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  visitor    VisitorSession? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([source, campaign])
}

model ProductCostHistory {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  unitCost      Int
  source        String
  effectiveFrom DateTime        @default(now())
  createdBy     String
  createdAt     DateTime        @default(now())
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([productId, variantId, effectiveFrom])
}

model OrderLineAnalytics {
  orderItemId    String    @id
  netAmount      Int
  unitCost       Int?
  costSource     String?
  costCapturedAt DateTime?
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
}

// Internal provenance only; public wording does not change financial execution mode.
model SyntheticBatch {
 id String @id
 createdAt DateTime @default(now())
 manifest String
}
model SyntheticRecord {
 id String @id
 batchId String
 entity String
 recordId String
 @@unique([entity, recordId])
 @@index([batchId])
}

model ShopperPreference {
 id String @id @default(cuid())
 userId String? @unique
 guestKey String? @unique
 language String @default("vi")
 region String @default("VN")
 currency String @default("VND")
 updatedAt DateTime @updatedAt
 user User? @relation(fields:[userId], references:[id], onDelete:Cascade)
}

model ProductReview {
  id String @id @default(cuid())
  userId String
  orderId String
  productId String
  rating Int
  comment String
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  order Order @relation(fields:[orderId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  replies ReviewReply[]
  @@unique([userId,orderId,productId])
  @@index([productId,hidden,createdAt])
}
model ReviewReply {
  id String @id @default(cuid())
  reviewId String
  actorId String
  eventKey String @unique
  content String
  createdAt DateTime @default(now())
  review ProductReview @relation(fields:[reviewId],references:[id])
  actor User @relation(fields:[actorId],references:[id])
}
model InquiryReply {
  id String @id @default(cuid())
  inquiryId String
  actorId String
  eventKey String @unique
  content String
  createdAt DateTime @default(now())
  inquiry Inquiry @relation(fields:[inquiryId],references:[id])
  actor User @relation(fields:[actorId],references:[id])
}
model Stocktake {
  id String @id @default(cuid())
  actorId String
  eventKey String @unique
  status String @default("DRAFT")
  reason String
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  actor User @relation(fields:[actorId],references:[id])
  lines StocktakeLine[]
  @@index([status,createdAt])
}
model StocktakeLine {
  id String @id @default(cuid())
  stocktakeId String
  variantId String
  bookStock Int
  countedStock Int
  damagedStock Int @default(0)
  stocktake Stocktake @relation(fields:[stocktakeId],references:[id])
  variant ProductVariant @relation(fields:[variantId],references:[id])
  @@unique([stocktakeId,variantId])
}
